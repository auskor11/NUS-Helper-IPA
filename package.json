{
  "name": "nus-helper-ipa",
  "private": true,
  "version": "1.0.0",
  "description": "Native iOS wrapper (Capacitor) for the NUS Companion web app",
  "type": "module",
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "sync": "npm run sync-web && npx cap sync ios && node scripts/patch-ios.mjs",
    "open": "npx cap open ios",
    "build-ipa": "npm run sync && bash scripts/build-ipa.sh"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
